FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv==0.9.7
COPY pyproject.toml uv.lock ./
COPY packages/shared packages/shared
COPY apps/api apps/api
COPY apps/voice-worker/pyproject.toml apps/voice-worker/pyproject.toml
RUN uv sync --frozen --package techfi-api --no-dev --no-editable
USER 10001:10001
CMD ["/app/.venv/bin/uvicorn", "techfi_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--log-level", "critical"]
