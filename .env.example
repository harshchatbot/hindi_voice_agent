# Placeholders only. Keep actual credentials in ignored .env or injected environment values.
OPENAI_API_KEY=<openai-api-key>
SARVAM_API_KEY=<sarvam-api-key-for-stt-tts-and-optional-llm>
TECHFI_TENANT_ID=<internal-tenant-uuid>
TECHFI_STT_MODEL=<model-for-selected-stt-provider>
TECHFI_LLM_MODEL=<model-for-selected-llm-provider>
TECHFI_TTS_MODEL=<model-for-selected-tts-provider>
TECHFI_TTS_VOICE_ID=<voice-for-selected-tts-provider>

# Optional Google TTS authentication; omit to use local or attached-identity ADC.
# Credential files must live outside the repository. Do not paste JSON credentials here.
# GOOGLE_APPLICATION_CREDENTIALS=<absolute-path-to-secure-adc-or-service-account-file>

# Optional overrides. Omit these lines to use the validated defaults described in README.
# TECHFI_ENVIRONMENT=<development-or-production>
# TECHFI_STT_PROVIDER=<stt-adapter-name>
# TECHFI_LLM_PROVIDER=<llm-adapter-name>
# TECHFI_TTS_PROVIDER=<tts-adapter-name>
# TECHFI_STT_API_KEY=<role-specific-secret>
# TECHFI_LLM_API_KEY=<role-specific-secret>
# TECHFI_TTS_API_KEY=<role-specific-secret>
# Optional server-owned playground presets; model/voice IDs are never accepted from the browser.
# TECHFI_PLAYGROUND_SARVAM_MODEL=<sarvam-tts-model>
# TECHFI_PLAYGROUND_SARVAM_VOICE_ID=<sarvam-speaker>
# TECHFI_PLAYGROUND_OPENAI_MODEL=<openai-chat-model>
# TECHFI_PLAYGROUND_SARVAM_LLM_MODEL=<sarvam-conversations-model>
# TECHFI_PLAYGROUND_SARVAM_V4_MODEL=<sarvam-v4-flash-model>
# TECHFI_PLAYGROUND_SARVAM_V4_VOICE_ID=<supported-v4-hindi-male-persona>
# TECHFI_SARVAM_LLM_BASE_URL=<official-sarvam-v1-base-url>
# TECHFI_SARVAM_TTS_WEBSOCKET_URL=<official-sarvam-tts-websocket-url>
# TECHFI_PLAYGROUND_GOOGLE_MODEL=<google-tts-family>
# TECHFI_PLAYGROUND_GOOGLE_VOICE_ID=<google-chirp3-hd-voice>
# TECHFI_LANGUAGE=<supported-language-code>
# TECHFI_STT_MODE=<supported-transcription-mode>
# TECHFI_STT_STREAM_TYPE=<balanced-or-fast>
# TECHFI_STT_KEEPALIVE_SECONDS=<seconds>
# TECHFI_STT_FINAL_TIMEOUT_SECONDS=<seconds>
# TECHFI_SYSTEM_PROMPT=<approved-conversation-style>
# TECHFI_GREETING=<ai-disclosure-greeting>
# TECHFI_OPT_OUT_REPLY=<respectful-closing-message>
# TECHFI_OPT_OUT_PHRASES=["<explicit-opt-out-phrase>"]
# TECHFI_MAX_SESSION_SECONDS=<duration>
# TECHFI_PROVIDER_TIMEOUT_SECONDS=<duration>
# TECHFI_CONNECTION_TIMEOUT_SECONDS=<duration>
# TECHFI_CLEANUP_TIMEOUT_SECONDS=<duration>
# TECHFI_IDLE_TIMEOUT_SECONDS=<duration>
# TECHFI_OPT_OUT_GRACE_SECONDS=<duration>
# TECHFI_VAD_CONFIDENCE=<probability>
# TECHFI_VAD_START_SECONDS=<duration>
# TECHFI_VAD_STOP_SECONDS=<duration>
# TECHFI_TURN_SILENCE_SECONDS=<duration>
# TECHFI_HOST=<loopback-host>
# TECHFI_PORT=<local-port>
# TECHFI_MAX_SESSIONS=<concurrency-limit>

# Fictional Soft Collection demo only. Real collection/identity verification is unsupported.
# TECHFI_COLLECTION_DEMO_ENABLED=<true-or-false>
# TECHFI_COLLECTION_START_HOUR=<india-hour-at-or-after-8>
# TECHFI_COLLECTION_END_HOUR=<india-hour-at-or-before-19>
# TECHFI_COLLECTION_MAX_ATTEMPTS_PER_DAY=<bank-approved-demo-limit>
# TECHFI_COLLECTION_RETRY_GAP_SECONDS=<bank-approved-demo-gap>
# TECHFI_ASSISTANT_MALE_NAME=<assistant-name-letters-only>
# TECHFI_ASSISTANT_FEMALE_NAME=<assistant-name-letters-only>
# TECHFI_PLAYGROUND_SARVAM_FEMALE_VOICE_ID=<supported-v3-female-voice>
# TECHFI_PLAYGROUND_SARVAM_V4_FEMALE_VOICE_ID=<supported-v4-female-persona>
# TECHFI_PLAYGROUND_GOOGLE_FEMALE_VOICE_ID=<supported-google-female-voice>

# Separate native fictional simulation only; explicit CLI opt-in is also required.
# Uses SARVAM_API_KEY above. Normal collection policy is unaffected.
TECHFI_NATIVE_ENVIRONMENT=production
